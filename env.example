# IPFS Configuration
# Copy this file to .env and add your actual credentials

# Infura IPFS (if using Infura)
VITE_INFURA_PROJECT_ID=your_infura_project_id
VITE_INFURA_PROJECT_SECRET=your_infura_project_secret

# Pinata (if using Pinata)
VITE_PINATA_API_KEY=your_pinata_api_key
VITE_PINATA_SECRET_KEY=your_pinata_secret_key

# Web3.Storage (if using Web3.Storage)
VITE_WEB3STORAGE_TOKEN=your_web3storage_token

